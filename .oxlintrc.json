{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": ["typescript", "vue", "oxc"],
  "env": {
    "browser": true,
    "node": true
  },
  "globals": {
    "process": "readonly",
    "ga": "readonly",
    "cordova": "readonly",
    "Capacitor": "readonly",
    "chrome": "readonly",
    "browser": "readonly"
  },
  "rules": {
    "prefer-promise-reject-errors": "off",
    "no-debugger": "off"
  }
}
